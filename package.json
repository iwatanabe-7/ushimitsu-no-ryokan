{
  "name": "ushimitsu-ryokan",
  "productName": "丑三つの旅館",
  "version": "0.2.0",
  "description": "丑三つシリーズ第2作「丑三つの旅館」。一人称の3D脱出ホラー",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "author": "iwatanabe-7",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron": "vite build && electron .",
    "dist": "vite build && electron-builder",
    "dist:win": "vite build && electron-builder --win",
    "dist:mac": "vite build && electron-builder --mac",
    "dist:linux": "vite build && electron-builder --linux",
    "electron:dev": "node scripts/electron-dev.mjs",
    "build:cdn": "VITE_FONTS=cdn vite build --outDir dist-cdn",
    "test": "node --test --test-reporter=spec tests/*.test.mjs"
  },
  "devDependencies": {
    "@fontsource/shippori-mincho": "5.1.1",
    "@fontsource/yuji-boku": "^5.1.0",
    "electron": "45.3.3",
    "electron-builder": "26.18.0",
    "three": "0.160.0",
    "vite": "6.0.7"
  },
  "build": {
    "appId": "com.iwatanabe7.ushimitsuryokan",
    "productName": "丑三つの旅館",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "dir"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.games"
    },
    "linux": {
      "target": [
        "AppImage",
        "dir"
      ],
      "category": "Game"
    },
    "asar": true,
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "loadBrowserProcessSpecificV8Snapshot": false,
      "grantFileProtocolExtraPrivileges": false
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/iwatanabe-7/ushimitsu-no-ryokan.git"
  },
  "engines": {
    "node": ">=20"
  }
}
